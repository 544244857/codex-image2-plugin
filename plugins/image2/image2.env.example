# Copy to %USERPROFILE%\.codex\image2.env and fill in your own image relay settings.
# This file contains placeholders only. Do not share your completed image2.env.
BASE_URL=https://your-image-relay.example.com/v1
API_KEY=replace-with-your-image-relay-api-key
MODEL=gpt-image-1

# Optional: use model names and API modes supported by your relay.
# CHAT_MODEL=your-chat-image-model
# RESPONSES_MODEL=your-responses-model
# MODE=images

# Allow image2 to create missing visual assets during software development.
# Default is off. Set true to enable; explicit image-generation requests are unaffected.
# AUTO_GENERATE_ASSETS=false

# Default output: imagegen-output in the current project.
# Set a project-local output path when needed, or use -OutDir on the command line.
# OUT_DIR=C:\projects\demo\imagegen-output
